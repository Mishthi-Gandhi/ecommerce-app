<!DOCTYPE html>
<html lang="en">
<head><%- include("./partials/head", { title: "Checkout" }) %></head>
<body class="bg-light">
<%- include("./partials/nav") %>
<% const a = user.address || {}; %>
<main class="container my-4">
  <h2 class="mb-4">Checkout</h2>
  <form action="/order/place" method="POST">
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h4 class="mb-3">Shipping details</h4>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label">Full name</label>
                <input type="text" class="form-control" name="name" value="<%= user.name %>" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Phone number</label>
                <input type="tel" inputmode="numeric" maxlength="10" class="form-control" name="phoneNo" value="<%= user.phoneNo %>" required>
              </div>
            </div>
            <%- include("./partials/addressFields", { a }) %>
          </div>
        </div>

        <div class="card shadow-sm">
          <div class="card-body">
            <h4 class="mb-3">Payment method</h4>
            <% Object.entries(paymentMethods).forEach(([value, label], i) => { %>
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="paymentMethod" id="pm-<%= value %>" value="<%= value %>" <%= i === 0 ? "checked" : "" %>>
                <label class="form-check-label" for="pm-<%= value %>"><%= label %></label>
              </div>
            <% }) %>
            <p class="form-text mb-0">"Online Payment (Demo)" is a simulation for this portfolio project. No real money is charged.</p>
          </div>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="card shadow-sm">
          <div class="card-body">
            <h4 class="mb-3">Order summary</h4>
            <% cart.products.forEach(item => { const p = item.productId; %>
              <div class="d-flex align-items-center border-bottom pb-3 mb-3">
                <img src="<%= p.image[0] %>" class="cart-img rounded me-3" alt="">
                <div class="flex-grow-1">
                  <div class="fw-semibold"><%= p.name %></div>
                  <div class="small text-muted">₹<%= inr(p.price) %> × <%= item.quantity %></div>
                </div>
                <div>₹<%= inr(p.price * item.quantity) %></div>
              </div>
            <% }) %>
            <div class="d-flex justify-content-between fs-5 fw-bold mb-3"><span>Total</span><span>₹<%= inr(total) %></span></div>
            <button type="submit" class="btn btn-success btn-lg w-100">Place order</button>
            <a href="/cart" class="btn btn-link w-100 mt-2">Back to cart</a>
          </div>
        </div>
      </div>
    </div>
  </form>
</main>
<%- include("./partials/script") %>
</body>
</html>
