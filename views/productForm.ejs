<!DOCTYPE html>
<html lang="en">
<head><%- include("./partials/head", { title: product ? "Edit product" : "Add product" }) %></head>
<body>
<%- include("./partials/nav") %>
<% const p = product || {}; %>
<main class="container my-4" style="max-width: 720px;">
  <h2 class="mb-4"><%= product ? "Edit product" : "Add a new product" %></h2>
  <form action="<%= product ? '/product/' + product._id : '/product' %>" method="post" enctype="multipart/form-data" class="card card-body shadow-sm">
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input type="text" class="form-control" name="name" value="<%= p.name || '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea class="form-control" name="description" rows="3" required><%= p.description || '' %></textarea>
    </div>
    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Price (₹)</label>
        <input type="number" min="0" step="0.01" class="form-control" name="price" value="<%= p.price ?? '' %>" required>
      </div>
      <div class="col-md-4 mb-3">
        <label class="form-label">Category</label>
        <input type="text" class="form-control" name="category" value="<%= p.category || '' %>" required>
      </div>
      <div class="col-md-4 mb-3">
        <label class="form-label">Stock</label>
        <input type="number" min="0" step="1" class="form-control" name="stock" value="<%= p.stock ?? '' %>" required>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Image <%= product ? "(leave empty to keep the current one)" : "(optional)" %></label>
      <% if (product) { %><div class="mb-2"><img src="<%= p.image[0] %>" height="90" class="rounded border" alt=""></div><% } %>
      <input type="file" class="form-control" name="image" accept="image/*">
    </div>
    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary"><%= product ? "Save changes" : "Add product" %></button>
      <a href="<%= product ? '/product/' + product._id : '/product' %>" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</main>
<%- include("./partials/script") %>
</body>
</html>
